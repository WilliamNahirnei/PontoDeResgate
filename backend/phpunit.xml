<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
            <directory>Modules/Usuarios/tests/Unit</directory>
            <directory>Modules/Resgates/tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
            <directory>Modules/Usuarios/tests/Feature</directory>
            <directory>Modules/Resgates/tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
            <directory>Modules/Usuarios/app</directory>
            <directory>Modules/Resgates/app</directory>
        </include>
    </source>
    <php>
        <!--
            force="true" é obrigatório em todas as entradas abaixo: o backend
            roda em Docker com "env_file: backend/.env" (ver docker-compose.yml
            na raiz), então DB_CONNECTION/DB_DATABASE etc. já chegam definidas
            como variáveis de ambiente reais do container. Sem force="true", o
            PHPUnit não as sobrescreve e os testes acabam rodando contra o
            MySQL de desenvolvimento (RefreshDatabase chega a dar migrate:fresh
            nele, apagando dados reais) em vez do sqlite em memória.
        -->
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file" force="true"/>
        <env name="BCRYPT_ROUNDS" value="4" force="true"/>
        <env name="BROADCAST_CONNECTION" value="null" force="true"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <env name="DB_CONNECTION" value="sqlite" force="true"/>
        <env name="DB_DATABASE" value=":memory:" force="true"/>
        <env name="DB_URL" value="" force="true"/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <env name="PULSE_ENABLED" value="false" force="true"/>
        <env name="TELESCOPE_ENABLED" value="false" force="true"/>
        <env name="NIGHTWATCH_ENABLED" value="false" force="true"/>

        <!--
            Laravel lê variáveis de ambiente via $_SERVER antes de $_ENV, e o
            bloco <env> acima não sobrescreve $_SERVER (apenas $_ENV/getenv).
            Sem este bloco espelhado, $_SERVER['DB_CONNECTION'] continuaria
            "mysql" (herdado do env_file do container) mesmo com force="true"
            acima, e os testes voltariam a rodar contra o banco de dev.
        -->
        <server name="APP_ENV" value="testing" force="true"/>
        <server name="APP_MAINTENANCE_DRIVER" value="file" force="true"/>
        <server name="BCRYPT_ROUNDS" value="4" force="true"/>
        <server name="BROADCAST_CONNECTION" value="null" force="true"/>
        <server name="CACHE_STORE" value="array" force="true"/>
        <server name="DB_CONNECTION" value="sqlite" force="true"/>
        <server name="DB_DATABASE" value=":memory:" force="true"/>
        <server name="DB_URL" value="" force="true"/>
        <server name="MAIL_MAILER" value="array" force="true"/>
        <server name="QUEUE_CONNECTION" value="sync" force="true"/>
        <server name="SESSION_DRIVER" value="array" force="true"/>
        <server name="PULSE_ENABLED" value="false" force="true"/>
        <server name="TELESCOPE_ENABLED" value="false" force="true"/>
        <server name="NIGHTWATCH_ENABLED" value="false" force="true"/>
    </php>
</phpunit>
