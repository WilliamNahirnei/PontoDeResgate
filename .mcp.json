{
    "mcpServers": {
        "laravel-boost": {
            "command": "docker",
            "args": [
                "compose",
                "exec",
                "-T",
                "backend",
                "php",
                "artisan",
                "boost:mcp"
            ]
        },
        "playwright": {
            "command": "docker",
            "args": [
                "run",
                "--rm",
                "-i",
                "--network",
                "host",
                "-e",
                "DISPLAY",
                "-v",
                "/tmp/.X11-unix:/tmp/.X11-unix:ro",
                "mcr.microsoft.com/playwright:v1.63.0-noble",
                "npx",
                "@playwright/mcp@0.0.80",
                "--browser",
                "chromium",
                "--viewport-size",
                "1280,720"
            ]
        }
    }
}
