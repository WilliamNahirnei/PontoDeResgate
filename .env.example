# Variaveis lidas apenas pelo docker-compose.yml (desenvolvimento local).
# Nao sao lidas pelo Laravel nem pelo Vue - cada um tem seu proprio .env
# em backend/.env e frontend/.env.

# Portas expostas no host
BACKEND_PORT=8000
FRONTEND_PORT=5173
DB_PORT=3306

# Credenciais do MySQL de desenvolvimento
# (devem bater com DB_DATABASE/DB_USERNAME/DB_PASSWORD em backend/.env)
DB_DATABASE=ponto_de_resgate
DB_USERNAME=ponto_de_resgate
DB_PASSWORD=secret
DB_ROOT_PASSWORD=root

# Roda "php artisan migrate" automaticamente ao subir o backend
RUN_MIGRATIONS=true

# Usado apenas para o build do frontend em dev (embutido no bundle Vite)
VITE_API_BASE_URL=http://localhost:8000
